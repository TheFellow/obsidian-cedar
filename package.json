{
  "name": "obsidian-cedar",
  "version": "0.1.1",
  "description": "Cedar policy language syntax highlighting for Obsidian",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/vscode-textmate": "10.1.0",
    "@types/node": "22.20.5",
    "@types/prismjs": "1.26.6",
    "esbuild": "0.28.2",
    "obsidian": "1.14.4",
    "prismjs": "1.30.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
